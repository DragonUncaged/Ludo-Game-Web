# Neon Postgres — use the POOLED (-pooler) connection string for app queries
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Realtime (Colyseus) server
REALTIME_PORT=2567
# Allow the same device token to join a room twice (multi-tab local dev only)
ALLOW_DUP_DEVICE=0
# Comma-separated dice values for scripted animation testing (dev only), e.g. 6,2,6,5
FIXED_ROLLS=

# API server
API_PORT=8080

# Client (Vite)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:2567
