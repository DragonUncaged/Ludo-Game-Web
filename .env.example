# Postgres. Use Neon's pooled (-pooler) string in production. Leave unset to run
# without persistence: games still work, wallet/shop/leaderboard return 503.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Comma-separated origins allowed to call the api/realtime servers (default: any)
CORS_ORIGIN=

# Realtime (Colyseus) server
REALTIME_PORT=2567
# Allow the same device token to join a room twice (multi-tab local testing only)
ALLOW_DUP_DEVICE=0
# Scripted dice for animation testing (dev only), e.g. 6,2,6,5
FIXED_ROLLS=

# API server
API_PORT=8080
# Enables /admin/* when set; send it as "Authorization: Bearer <token>"
ADMIN_TOKEN=

# Client (Vite reads these from apps/client/.env*)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:2567
